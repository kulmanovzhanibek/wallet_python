# ============================== Приложение ==============================
APP_ENV=dev                  # dev | test | prod
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ============================== Telegram ===============================
# Обязательно. Токен от @BotFather — без него процесс не стартует.
BOT_TOKEN=
# Нужны только для вебхука (прод). Локально работает bot-polling.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# ============================== PostgreSQL =============================
# Обязательно.
DATABASE_URL=postgresql+asyncpg://koshelek:koshelek@db:5432/koshelek
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ================================ Redis ================================
# Обязательно. FSM бота, кэш курсов, идемпотентность, очередь arq.
REDIS_URL=redis://redis:6379/0

# ============================= Курсы валют =============================
FX_API_URL=https://open.er-api.com/v6/latest
FX_API_KEY=

# ========================== Значения по умолчанию ======================
DEFAULT_CURRENCY=KZT
DEFAULT_TIMEZONE=UTC
