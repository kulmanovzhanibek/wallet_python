# ============================== Приложение ==============================
APP_ENV=dev                  # dev | test | prod
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ============================== Telegram ===============================
# Обязательно. Токен от @BotFather — без него процесс не стартует.
BOT_TOKEN=
# Нужны только для вебхука (прод). Локально работает bot-polling.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# ============================== PostgreSQL =============================
# Обязательно. Значение — для инструментов, которые запускаются НА МАШИНЕ
# разработчика (alembic, pytest): docker compose публикует порт на localhost.
# Контейнерам api/worker compose подставит хост `db` своими переменными —
# внутри сети docker имя `db` разрешается, а с хоста нет.
DATABASE_URL=postgresql+asyncpg://koshelek:koshelek@127.0.0.1:5432/koshelek
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# База для интеграционных тестов. Если не задана — тесты попробуют поднять
# контейнер через testcontainers, а без Docker просто пропустятся.
TEST_DATABASE_URL=postgresql+asyncpg://koshelek:koshelek@127.0.0.1:5432/koshelek

# ================================ Redis ================================
# Обязательно. FSM бота, кэш курсов, идемпотентность, очередь arq.
REDIS_URL=redis://127.0.0.1:6379/0

# ============================= Курсы валют =============================
FX_API_URL=https://open.er-api.com/v6/latest
FX_API_KEY=

# ========================== Значения по умолчанию ======================
DEFAULT_CURRENCY=KZT
DEFAULT_TIMEZONE=UTC
